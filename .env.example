# Host ports used by Docker Compose.
WEB_PORT=8080
BACKEND_PORT=8787

# Backend logging: debug, info, warn, or error.
LOG_LEVEL=info

# At frontend build time, use `same-origin`, `disabled`, or a full ws(s):// URL.
# Production defaults to same-origin; Docker Compose sets it explicitly.
PUBLIC_MATCH_SERVER=same-origin
